# Copy this file to .env and set the values.
# Do not commit the .env file.

# Required. Value of the refreshToken cookie from api.inzhur.reit.
# The program uses it only for the first sync after you change it.
INZHUR_REFRESH_TOKEN=

# Required. Base URL of your Ghostfolio instance.
GHOSTFOLIO_URL=http://localhost:3333

# Required. Ghostfolio access token with the activity:create scope.
GHOSTFOLIO_ACCESS_TOKEN=

# Required. ID of the Ghostfolio account that receives the activities.
GHOSTFOLIO_ACCOUNT_ID=

# Required. Directory where the program keeps the current refresh token.
DATA_DIR=./data

# Optional. Ghostfolio symbol for an Inzhur asset ID.
# SYMBOL_MAP=21=GF_INZHUR-REIT,36=GF_UA4000238976

# Optional. Set to true to do all steps but send nothing to Ghostfolio.
# DRY_RUN=true
