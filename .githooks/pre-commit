#!/bin/sh
# Stops a commit that contains a secret or Go code that is not formatted.
# To enable the hooks: git config core.hooksPath .githooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed. See https://github.com/gitleaks/gitleaks" >&2
    exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$files" ]; then
    # shellcheck disable=SC2086
    unformatted=$(gofmt -l $files)
    if [ -n "$unformatted" ]; then
        echo "pre-commit: run gofmt on these files:" >&2
        echo "$unformatted" >&2
        exit 1
    fi
fi

if command -v golangci-lint >/dev/null 2>&1; then
    golangci-lint run
fi
